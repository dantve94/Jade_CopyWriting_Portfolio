<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.name }}, {{ site.role }}</title>
  <meta name="description" content="{{ description or excerpt or site.positioning }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or excerpt or site.positioning }}">
  <meta property="og:type" content="website">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cg fill='%23f5b700' stroke='%232b2118' stroke-width='1.2'%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(0 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(30 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(60 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(90 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(120 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(150 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(180 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(210 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(240 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(270 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(300 20 20)'/%3E%3Cellipse cx='20' cy='8.2' rx='3.4' ry='6.6' transform='rotate(330 20 20)'/%3E%3C/g%3E%3Ccircle cx='20' cy='20' r='6.8' fill='%232b2118'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
