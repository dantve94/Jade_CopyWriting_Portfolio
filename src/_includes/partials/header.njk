<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-role">{{ site.role }}</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/work/" {% if page.url.startsWith("/work/") %}aria-current="page"{% endif %}>Work</a>
      <a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a>
      {% if site.resume %}<a href="{{ site.resume }}">Résumé</a>{% endif %}
      <a class="btn btn-small" href="mailto:{{ site.email }}">Get in touch</a>
    </nav>
  </div>
</header>
