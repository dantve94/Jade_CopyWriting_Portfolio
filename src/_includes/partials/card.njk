<article class="card" data-section="{{ item.data.section | slugify }}">
  <a class="card-link" href="{{ item.url }}">
    <div class="card-meta">
      <span class="tag">{{ item.data.format }}</span>
      {% if item.data.type == "personal" %}<span class="tag tag-quiet">Personal work</span>{% endif %}
    </div>
    <h3 class="card-title">{{ item.data.title }}</h3>
    <p class="card-client">{{ item.data.byline }}</p>
    <p class="card-excerpt">{{ item.data.excerpt | truncate(170) }}</p>
    <span class="card-cta">Have a read <span aria-hidden="true">→</span></span>
  </a>
</article>
