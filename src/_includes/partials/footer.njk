<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-title">Let's work together.</p>
      <p class="muted">Based in {{ site.location }}, writing for brands anywhere.</p>
    </div>
    <ul class="contact-list">
      <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      <li><a href="{{ site.linkedin }}" rel="noopener">LinkedIn</a></li>
    </ul>
  </div>
  <div class="wrap footer-small muted">© {{ site.name }}</div>
</footer>
