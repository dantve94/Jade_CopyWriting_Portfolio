<svg class="sunflower{% if sfClass %} {{ sfClass }}{% endif %}" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <g class="petals">
    {%- for i in range(0, 12) %}
    <ellipse cx="20" cy="8.2" rx="3.4" ry="6.6" transform="rotate({{ i * 30 }} 20 20)"/>
    {%- endfor %}
  </g>
  <circle class="seed" cx="20" cy="20" r="6.8"/>
  <g class="seed-dots"><circle cx="18" cy="18.5" r=".9"/><circle cx="22" cy="18.5" r=".9"/><circle cx="20" cy="21.8" r=".9"/></g>
</svg>
